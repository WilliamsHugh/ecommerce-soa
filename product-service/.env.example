# HTTP - Render injects PORT automatically
PORT=3002
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-or-api-gateway.example.com

# Must be exactly the same JWT_ACCESS_SECRET as user-service.
JWT_ACCESS_SECRET=replace-with-the-user-service-access-secret
JWT_ISSUER=ecommerce-user-service
JWT_AUDIENCE=ecommerce-api

# Bonsai Sandbox (managed Elasticsearch/OpenSearch)
# Paste the complete HTTPS URL from Bonsai. Embedded credentials are supported,
# for example: https://username:password@cluster-id.bonsaisearch.net
PRODUCT_STORE_DRIVER=elasticsearch
ELASTICSEARCH_URL=https://username:password@cluster-id.bonsaisearch.net
ELASTICSEARCH_INDEX=products
# Optional alternative when your provider gives credentials separately.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Optional S3-compatible image storage. Leave all values empty to disable uploads.
S3_ENDPOINT=
S3_HEALTH_URL=
S3_REGION=auto
S3_BUCKET=product-images
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_IMAGE_BYTES=5242880
