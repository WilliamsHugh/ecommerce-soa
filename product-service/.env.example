# HTTP - Render injects PORT automatically
PORT=3002
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-or-api-gateway.example.com

# Must be exactly the same JWT_ACCESS_SECRET as user-service.
JWT_ACCESS_SECRET=replace-with-the-user-service-access-secret
JWT_ISSUER=ecommerce-user-service
JWT_AUDIENCE=ecommerce-api

# MongoDB Atlas M0 (managed datastore)
# Atlas > Cluster > Connect > Drivers > Node.js. Replace <db_password> and keep
# the database name in the URI. URL-encode special characters in the password.
# Never commit a real connection string.
PRODUCT_STORE_DRIVER=mongodb
MONGODB_URI=mongodb+srv://username:<db_password>@cluster0.example.mongodb.net/product_service?retryWrites=true&w=majority
MONGODB_DATABASE=product_service
MONGODB_PRODUCTS_COLLECTION=products
MONGODB_RESERVATIONS_COLLECTION=reservations
MONGODB_CONNECTION_TIMEOUT_MS=30000

# Optional S3-compatible image storage. Leave all values empty to disable uploads.
S3_ENDPOINT=
S3_HEALTH_URL=
S3_REGION=auto
S3_BUCKET=product-images
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_IMAGE_BYTES=5242880
