# HTTP
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT - replace both values with long, independent random secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d
JWT_ISSUER=ecommerce-user-service
JWT_AUDIENCE=ecommerce-api

# Authentication protection
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=900

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_users
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_CONNECTION_LIMIT=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ecommerce:user-service:

# Optional initial admin, used only by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
