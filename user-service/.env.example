# HTTP
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT - replace both values with long, independent random secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d
JWT_ISSUER=ecommerce-user-service
JWT_AUDIENCE=ecommerce-api

# Authentication protection
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=900

# Aiven for MySQL
# Copy Host, Port, Database, User and Password from:
# Aiven Console > your MySQL service > Overview > Connection information.
# Do not include mysql:// or :PORT in MYSQL_HOST.
MYSQL_HOST=mysql-project-name.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-with-aiven-service-password
MYSQL_CONNECTION_LIMIT=10

# Download the CA certificate from the same Aiven page, then encode it as one line:
# Linux/macOS: base64 < ca.pem | tr -d '\n'
# Set this value as a Render secret. TLS certificate verification is enabled when set.
MYSQL_SSL_CA_BASE64=replace-with-base64-encoded-aiven-ca-certificate

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ecommerce:user-service:

# Optional initial admin, used only by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
