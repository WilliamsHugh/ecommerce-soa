PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Must match user-service and every service that validates access tokens.
JWT_ACCESS_SECRET=development-secret-change-me
JWT_ISSUER=ecommerce-user-service
JWT_AUDIENCE=ecommerce-api

USER_SERVICE_URL=http://127.0.0.1:3001
PRODUCT_SERVICE_URL=http://127.0.0.1:3002
ORDER_SERVICE_URL=http://127.0.0.1:3003
PAYMENT_SERVICE_URL=http://127.0.0.1:3004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3005

UPSTREAM_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
MAX_BODY_BYTES=2097152
